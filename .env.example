# ===== RSVP хадгалалт (сонголт) =====
# Production дээр хариултыг байнга хадгалахын тулд Vercel KV (эсвэл Upstash Redis) үүсгээд
# дараах хувьсагчдыг тохируулна. Тохируулаагүй бол локал дээр .data/rsvp.json файлд хадгална
# (Vercel serverless дээр энэ нь түр зуурынх тул KV ашиглахыг зөвлөнө).

# Vercel KV / Upstash Redis REST
KV_REST_API_URL=
KV_REST_API_TOKEN=
# эсвэл:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== Админ хуудасны нууц түлхүүр =====
# /admin хуудсыг хамгаалах түлхүүр. Тохируулбал /admin?key=... гэж нэвтэрнэ.
ADMIN_KEY=
